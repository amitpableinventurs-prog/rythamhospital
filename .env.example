# ── Website ─────────────────────────────────────────────
# Public address of the site (no trailing slash). Used for canonical URLs,
# the sitemap, social previews and links in notification emails.
SITE_URL=https://www.example.com
PORT=5088
# Only on the live server. Leave it out of a local .env (Vite would otherwise bundle React in dev mode).
NODE_ENV=production

# ── MySQL ───────────────────────────────────────────────
# The database is created automatically on first start.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=rhythm_hospital

# ── Admin panel (/admin) ────────────────────────────────
# Long random string. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
# The first admin account is created from these on first start only.
# Change the password afterwards from the admin panel.
ADMIN_NAME=Administrator
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=

# ── Email notifications for contact & appointment forms ─
# Leave SMTP_HOST empty to disable email (submissions are still saved).
# Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=465, SMTP_SECURE=true and an
# App Password (Google Account > Security > App passwords) as SMTP_PASS.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Rhythm Hospital Website <no-reply@example.com>"
# Inbox that receives the notifications.
MAIL_TO=rhythemmultispeciality@gmail.com
